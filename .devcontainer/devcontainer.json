{
  "name": "ComfyUI Cloud",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "forwardPorts": [8188],
  "portsAttributes": {
    "8188": {
      "label": "ComfyUI",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash setup_cloud_comfyui.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
